#!/usr/bin/env bash
set -euo pipefail

# Datakraften Installer
# Downloads the latest 'dk' CLI binary from GitHub Releases,
# with a fallback to building from source.
#
# Usage:
#   curl -fsSL https://datakraften.no/install | bash
#   curl -fsSL https://datakraften.no/install | bash -s -- --version

REPO="sagathelab/datakraften"
BIN_DIR="${HOME}/.local/bin"
BINARY="${BIN_DIR}/dk"
VERSION="dev"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}  ${1}${NC}"; }
ok()    { echo -e "${GREEN}  ✓ ${1}${NC}"; }
warn()  { echo -e "${YELLOW}  ⚠ ${1}${NC}"; }
err()   { echo -e "${RED}  ✗ ${1}${NC}"; }

# --- Fallback: build from source ---
install_from_source() {
	info "Building dk from source..."

	if ! command -v git &>/dev/null || ! command -v go &>/dev/null; then
		err "Building from source requires git and Go 1.23 or newer."
		return 1
	fi

	SOURCE_DIR="${HOME}/.local/share/datakraften/source"
	mkdir -p "$(dirname "${SOURCE_DIR}")"

	if [ -d "${SOURCE_DIR}/.git" ]; then
		cd "${SOURCE_DIR}" && git pull --ff-only
	else
		git clone --depth 1 "https://github.com/${REPO}.git" "${SOURCE_DIR}"
	fi

	cd "${SOURCE_DIR}"
	mkdir -p bin
	CGO_ENABLED=0 go build -o bin/dk ./cmd/dk/
	mkdir -p "${BIN_DIR}"
	cp bin/dk "${BINARY}"
	chmod +x "${BINARY}"
	ok "dk built and installed from source"
}

# ============================================================
# Main
# ============================================================

echo ""
echo -e "${CYAN}Datakraften Installer${NC}"
echo ""

# --- Flags ---

if [ "${1:-}" = "--version" ]; then
	echo "Datakraften installer ${VERSION}"
	exit 0
fi

# --- Pre-flight ---

if [ "$(id -u)" = "0" ]; then
	err "Do not run this installer as root."
	err "Run it as a regular user with sudo privileges."
	exit 1
fi

if grep -qi microsoft /proc/version 2>/dev/null || grep -qi wsl /proc/version 2>/dev/null; then
	info "WSL environment detected"
elif [ "$(uname)" = "Darwin" ]; then
	info "macOS environment detected"
else
	info "Native Linux environment detected"
fi

# --- Detect platform ---

OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)

case "$ARCH" in
	x86_64|amd64)  ARCH="amd64" ;;
	aarch64|arm64) ARCH="arm64" ;;
	*)
		err "Unsupported architecture: $ARCH"
		exit 1
		;;
esac

case "$OS" in
	linux|darwin) ;;
	*)
		err "Unsupported OS: $OS"
		exit 1
		;;
esac

ASSET="dk-${OS}-${ARCH}"

# --- Fetch latest release ---

API_URL="https://api.github.com/repos/${REPO}/releases/latest"
info "Fetching latest release..."

RELEASE_JSON=""
TAG_NAME=""

if command -v curl &>/dev/null; then
	RELEASE_JSON=$(curl -fsSL "${API_URL}" 2>/dev/null || true)
elif command -v wget &>/dev/null; then
	RELEASE_JSON=$(wget -qO- "${API_URL}" 2>/dev/null || true)
fi

if [ -n "${RELEASE_JSON}" ]; then
	TAG_NAME=$(printf '%s\n' "${RELEASE_JSON}" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
fi

if [ -z "${TAG_NAME}" ]; then
	warn "No release found. Falling back to source build."
	echo ""
	install_from_source
	SOURCE_INSTALL=true
else
	SOURCE_INSTALL=false
fi

if [ "${SOURCE_INSTALL}" = false ]; then
ok "Latest release: ${TAG_NAME}"

# --- Download binary ---

DOWNLOAD_URL="https://github.com/${REPO}/releases/download/${TAG_NAME}/${ASSET}"
CHECKSUM_URL="${DOWNLOAD_URL}.sha256"

TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/datakraften.XXXXXXXX")
trap 'rm -rf "${TEMP_DIR}"' EXIT

info "Downloading ${ASSET}..."

if command -v curl &>/dev/null; then
	curl -fsSL "${DOWNLOAD_URL}" -o "${TEMP_DIR}/${ASSET}"
else
	wget -qO "${TEMP_DIR}/${ASSET}" "${DOWNLOAD_URL}"
fi

ok "Binary downloaded"

# --- Verify checksum ---

CHECKSUM_OK=false
if command -v curl &>/dev/null; then
	CHECKSUM_RESPONSE=$(curl -fsSL "${CHECKSUM_URL}" 2>/dev/null || true)
else
	CHECKSUM_RESPONSE=$(wget -qO- "${CHECKSUM_URL}" 2>/dev/null || true)
fi

if [ -n "${CHECKSUM_RESPONSE}" ]; then
	EXPECTED=$(echo "${CHECKSUM_RESPONSE}" | awk '{print $1}')
	if [ -n "${EXPECTED}" ]; then
		if command -v sha256sum &>/dev/null; then
			GOT=$(sha256sum "${TEMP_DIR}/${ASSET}" | awk '{print $1}')
			if [ "${GOT}" = "${EXPECTED}" ]; then
				CHECKSUM_OK=true
				ok "Checksum verified"
			else
				err "Checksum mismatch!"
				err "  expected: ${EXPECTED}"
				err "  got:      ${GOT}"
				rm -f "${TEMP_DIR}/${ASSET}"
				exit 1
			fi
		elif command -v shasum &>/dev/null; then
			GOT=$(shasum -a 256 "${TEMP_DIR}/${ASSET}" | awk '{print $1}')
			if [ "${GOT}" = "${EXPECTED}" ]; then
				CHECKSUM_OK=true
				ok "Checksum verified"
			else
				err "Checksum mismatch!"
				err "  expected: ${EXPECTED}"
				err "  got:      ${GOT}"
				rm -f "${TEMP_DIR}/${ASSET}"
				exit 1
			fi
		else
			warn "No checksum tool found, skipping verification"
		fi
	else
		warn "Could not parse checksum, skipping verification"
	fi
else
	warn "No checksum file found, skipping verification"
fi

# --- Install ---

info "Installing dk to ${BIN_DIR}..."
mkdir -p "${BIN_DIR}"
cp "${TEMP_DIR}/${ASSET}" "${BINARY}"
chmod +x "${BINARY}"
rm -f "${TEMP_DIR}/${ASSET}"
ok "dk installed to ${BINARY} (${TAG_NAME})"
fi

# --- Add to PATH ---

SHELL_CONFIG="${HOME}/.profile"
if [ "${SHELL:-}" = zsh ] || [ "${SHELL:-}" != "${SHELL%/zsh}" ]; then
	SHELL_CONFIG="${HOME}/.zshrc"
elif [ -f "${HOME}/.bashrc" ]; then
	SHELL_CONFIG="${HOME}/.bashrc"
fi

if ! printf '%s\n' "${PATH}" | tr ':' '\n' | grep -Fxq "${BIN_DIR}"; then
	if ! grep -Fq '# >>> datakraften >>>' "${SHELL_CONFIG}" 2>/dev/null; then
		cat >> "${SHELL_CONFIG}" <<- 'EOF'

# >>> datakraften >>>
export PATH="${HOME}/.local/bin:${PATH}"
# <<< datakraften <<<
EOF
		ok "Added ${BIN_DIR} to PATH in ${SHELL_CONFIG}"
	fi
fi

echo ""
ok "Datakraften installed successfully!"
echo ""
info "Next steps:"
info "  1. Restart your shell or run: source ${SHELL_CONFIG}"
info "  2. Run: dk init"
info "  3. Run: dk doctor"
echo ""
